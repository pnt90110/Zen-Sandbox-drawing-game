PORT=8000
BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-string
OIDC_ISSUER_BASE_URL=https://your-tenant.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPE=openid profile email
OIDC_REDIRECT_URI=http://localhost:8000/callback
OIDC_AUDIENCE=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Local MongoDB alternative (for Docker/local dev fallback):
# - If app runs on your host (npm run dev):
#   MONGODB_URI=mongodb://127.0.0.1:27017/zen_sandbox?directConnection=true
# - If app runs via docker compose app service:
#   MONGODB_URI=mongodb://mongo:27017/zen_sandbox?directConnection=true
MONGODB_DB=zen_sandbox
MONGODB_COLLECTION=sandbox_states
MONGODB_RETRY_MS=30000

# Optional API rate limits for state endpoints
STATE_READ_RATE_LIMIT_WINDOW_MS=60000
STATE_READ_RATE_LIMIT_MAX=120
STATE_WRITE_RATE_LIMIT_WINDOW_MS=60000
STATE_WRITE_RATE_LIMIT_MAX=30

# Express trust proxy config (set true when running behind a reverse proxy/LB)
# Accepted values: true/false, hop count (e.g. 1), or CSV subnet/IP list
EXPRESS_TRUST_PROXY=false
